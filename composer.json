{
    "name": "realmwatch/laravel-viti",
    "description": "Tripwires for Laravel apps: decoys and honey credentials that report every trip to Heimdall.",
    "keywords": ["laravel", "security", "canary", "honeypot", "tripwire", "heimdall"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Realmwatch\\Viti\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Realmwatch\\Viti\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Realmwatch\\Viti\\VitiServiceProvider"],
            "aliases": {
                "Viti": "Realmwatch\\Viti\\Facades\\Viti"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
